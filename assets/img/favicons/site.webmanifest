---
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "icons": [
    {
      "src": {{ '/assets/img/favicons/android-chrome-192x192.png' | relative_url | jsonify }},
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": {{ '/assets/img/favicons/android-chrome-512x512.png' | relative_url | jsonify }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "start_url": {{ '/' | relative_url | jsonify }},
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "standalone"
}
